# Generate a real secret: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=change-me-in-production-use-a-long-random-string

# Local SQLite (dev)
# DATABASE_URL=sqlite:///./expenses.db

# PostgreSQL (production)
DATABASE_URL=postgresql://expenses_user:password@localhost:5432/expenses

DEBUG=true
APP_NAME=Expenses

# --- Background scheduler (auto-pay + bill reminders) ---------------------
# Each uvicorn worker runs its own scheduler, so with `--workers N` the daily
# job fires N times. The job is idempotent (occurrences are claimed atomically
# and notifications are deduplicated), so this is safe either way — set it to
# false on all but one worker only to avoid the redundant work.
ENABLE_SCHEDULER=true

# --- Reverse proxy --------------------------------------------------------
# Enable ONLY when a trusted proxy in front of the app overwrites
# X-Forwarded-For. When false the header is ignored: clients could otherwise
# spoof their IP in security logs and escape rate-limit buckets.
TRUST_PROXY_HEADERS=false

# --- Rate limiting --------------------------------------------------------
# Empty = per-process memory, so limits apply per uvicorn worker. Point this at
# Redis to enforce login/2FA limits across all workers.
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379

# --- JWT (mobile / external API clients) ----------------------------------
# Defaults to APP_SECRET_KEY; set separately to isolate API tokens from sessions.
# JWT_SECRET_KEY=

# --- CORS -----------------------------------------------------------------
# Space-separated origins, e.g. "https://myapp.com capacitor://localhost"
# CORS_ALLOWED_ORIGINS=

# --- Web Push (VAPID) -----------------------------------------------------
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_CLAIMS_EMAIL=admin@example.com
