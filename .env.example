# REQUIRED: the app refuses to start without it (no built-in default).
# Generate a real secret: python -c "import secrets; print(secrets.token_hex(32))"
# Also needed by `alembic` commands, which load the app settings.
# The placeholder below is rejected when DEBUG=false.
APP_SECRET_KEY=change-me-in-production-use-a-long-random-string

# Local SQLite (dev)
# DATABASE_URL=sqlite:///./expenses.db

# PostgreSQL. docker-compose IGNORES this (it always uses the bundled `db`
# service); it is only for running uvicorn directly, or for a Coolify
# Dockerfile app (set it in the Coolify UI).
# DATABASE_URL=postgresql://expenses_user:password@localhost:5432/expenses

# Keep false in production (secure cookies, production secret checks). Set
# DEBUG=true ONLY for local development over plain http.
DEBUG=false

# Fernet key encrypting TOTP secrets at rest. If unset it is derived from
# APP_SECRET_KEY. Setting it later is safe (old secrets are re-encrypted on next
# login), but changing APP_SECRET_KEY without it makes stored TOTP secrets
# unreadable. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# A malformed key stops the app at startup.
# FIELD_ENCRYPTION_KEY=
APP_NAME=Expenses

# Verbosity of the app's own log output on stderr (what `docker logs` shows).
# uvicorn's access lines are unaffected. One of DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO

# Public URL of the app, used to build invite links (never the Host header).
# Required when DEBUG=false, e.g. https://expenses.example.com
APP_BASE_URL=

# --- Calendar timezone ----------------------------------------------------
# Bill due dates are plain calendar dates in your local time, so scheduled work
# ("is this due today?", reminder timing) is evaluated in this zone. Leave as
# UTC only if that is genuinely your calendar.
APP_TIMEZONE=UTC

# --- Background scheduler (auto-pay + bill reminders) ---------------------
# On PostgreSQL only one worker (the holder of advisory lock 727272) runs the
# scheduler, so leaving this true with `--workers N` is correct. On SQLite the
# single process always runs it. Set false to disable it entirely.
ENABLE_SCHEDULER=true

# --- Reverse proxy --------------------------------------------------------
# Enable ONLY when a trusted proxy in front of the app overwrites
# X-Forwarded-For. When false the header is ignored: clients could otherwise
# spoof their IP in security logs and escape rate-limit buckets.
TRUST_PROXY_HEADERS=false

# --- Rate limiting --------------------------------------------------------
# Empty = per-process memory, so limits apply per uvicorn worker. Point this at
# Redis to enforce login/2FA limits across all workers. Recommended on Coolify:
# `docker compose --profile redis up` and RATE_LIMIT_STORAGE_URI=redis://redis:6379
# Accounts also lock for 15 minutes after 10 failed password/2FA attempts.
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379

# --- JWT (mobile / external API clients) ----------------------------------
# Defaults to APP_SECRET_KEY; set separately to isolate API tokens from sessions.
# JWT_SECRET_KEY=

# --- CORS -----------------------------------------------------------------
# Space-separated origins, e.g. "https://myapp.com capacitor://localhost"
# CORS_ALLOWED_ORIGINS=

# --- Web Push (VAPID) -----------------------------------------------------
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_CLAIMS_EMAIL=admin@example.com

# --- New app at /app (off until cutover) and Pocket ID passkey sign-in ------
NEW_APP_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Open Food Facts barcode lookup (name, brand, size; see docs/OPENFOODFACTS.md)
# OPENFOODFACTS_ENABLED=true
# OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org
